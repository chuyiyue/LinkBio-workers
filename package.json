{
  "name": "linkbio-workers",
  "version": "2.0.0",
  "description": "Personal Bio / Digital Card on Cloudflare Workers — Next.js + Tailwind + Base UI Admin",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "npm run build:assets && next dev",
    "build": "npm run build:assets && next build",
    "build:themes": "node scripts/build-themes.mjs",
    "build:icons": "node scripts/build-icons.mjs",
    "build:assets": "npm run build:themes && npm run build:icons",
    "pretypecheck": "npm run build:assets",
    "build:worker": "npm run build:assets && opennextjs-cloudflare build --dangerouslyUseUnsupportedNextVersion",
    "preview": "npm run build:worker && opennextjs-cloudflare preview",
    "deploy": "npm run build:worker && opennextjs-cloudflare deploy",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint .",
    "cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
    "start": "next start"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@opennextjs/cloudflare": "^1.20.12",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-label": "^2.1.17",
    "@radix-ui/react-separator": "^1.2.0",
    "@radix-ui/react-slot": "^1.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.511.0",
    "next": "^15.5.23",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20250525.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "eslint": "^9.0.0",
    "eslint-config-next": "^15.5.23",
    "postcss": "^8.5.30",
    "tailwindcss": "^4.3.3",
    "typescript": "^5.9.3",
    "vite": "^6.4.5",
    "vitest": "^5.0.5",
    "wrangler": "^4.151.1"
  },
  "engines": {
    "node": ">=22"
  },
  "license": "GPL-3.0-or-later"
}
